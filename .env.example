# Copy to .env next to docker-compose.prod.yaml and fill in. The CloudFormation
# stack in deploy/aws/ writes this file on the instance for you, generating both
# secrets, so you only need this when deploying by hand.

# The domain Caddy requests a certificate for. Its DNS A record must already
# point at the server, or certificate issuance fails until it does.
SDIP_DOMAIN=interviews.example.com

# Let's Encrypt sends expiry warnings here.
SDIP_TLS_EMAIL=you@example.com

# Generate each with: openssl rand -hex 32
# Changing SDIP_JWT_SECRET invalidates every issued token and logs everyone out.
SDIP_JWT_SECRET=
POSTGRES_PASSWORD=

POSTGRES_USER=sdip
POSTGRES_DB=sdip

# Optional: turns on OpenTelemetry tracing and metrics, exported as OTLP
# straight to this endpoint (there is no collector in front of this stack).
# Leave unset to keep telemetry off.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
