# Copy to .env next to docker-compose.prod.yaml and fill in. The CloudFormation
# stack in deploy/aws/ writes this file on the instance for you, generating both
# secrets, so you only need this when deploying by hand.

# The domain Caddy requests a certificate for. Its DNS A record must already
# point at the server, or certificate issuance fails until it does.
SDIP_DOMAIN=interviews.example.com

# Let's Encrypt sends expiry warnings here.
SDIP_TLS_EMAIL=you@example.com

# Generate each with: openssl rand -hex 32
# Changing SDIP_JWT_SECRET invalidates every issued token and logs everyone out.
SDIP_JWT_SECRET=
POSTGRES_PASSWORD=

POSTGRES_USER=sdip
POSTGRES_DB=sdip

# Reported on every trace and metric as deployment.environment. Leave unset
# on the sdip (dev) stack; set to "production" on sdip-prod.
SDIP_ENVIRONMENT=

# This same docker-compose.prod.yaml runs on both the sdip and sdip-prod AWS
# stacks, so its Docker network needs a name that tells them apart — leave
# unset on sdip (defaults to "sdip"); set to "sdip-prod" on sdip-prod.
# Mismatching this against what's actually running recreates the network
# out from under the other containers, taking the stack down until it's
# fixed — see docker-compose.prod.yaml's own comment on this.
SDIP_NETWORK_NAME=

# Optional: turns on OpenTelemetry tracing and metrics, exported as OTLP
# straight to this endpoint (there is no collector in front of this stack).
# Leave unset to keep telemetry off. observability/README.md has the setup
# for a shared collector/Grafana stack running on one of the two instances.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
